# ===============================
# MPI-only Makefile
# ===============================

CXX      = mpic++
CXXFLAGS = -std=c++17 -O3 -Wall -Wextra -pedantic
CPPFLAGS = -I.

EXEC = main_parallel_mpi_only

SRCS = main_parallel.cpp \
       pso_mpi.cpp \
       functions.cpp \
       interfaces.cpp

OBJS = $(SRCS:.cpp=.o)

.PHONY: all clean run

all: $(EXEC)

$(EXEC): $(OBJS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -o $@ $^

%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $<

run: $(EXEC)
	mpirun -np 4 ./$(EXEC)

clean:
	rm -f *.o $(EXEC)
