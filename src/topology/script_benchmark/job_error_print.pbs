spack load gcc@15.2.0
spack load openmpi@5.0.8

# Spostati nella directory dove ti trovi ora
cd "/home/u10848893/AMSC-Project/AMSC-Project/src/topology/script_benchmark"

# Assicurati che lo script sia eseguibile e lancialo
chmod +x run_error_printing.sh
./run_error_printing.sh
